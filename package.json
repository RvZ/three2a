{
  "name": "gta2-style-game",
  "version": "1.0.0",
  "description": "A top-down GTA-inspired game built with TypeScript and Three.js",
  "type": "module",
  "main": "js/core/main.ts",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node test/e2e/boot.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mjs,json,md}\""
  },
  "keywords": [
    "game",
    "threejs",
    "typescript",
    "javascript",
    "webgl",
    "gta"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "playwright": "^1.61.1",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
